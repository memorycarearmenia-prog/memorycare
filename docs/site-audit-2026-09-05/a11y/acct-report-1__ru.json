   "img[src$=\"passport.svg\"]",
   "img[src$=\"tel.svg\"]"
  ]
 },
 {
  "id": "landmark-one-main",
  "impact": "moderate",
  "help": "Document should have one main landmark",
  "n": 1,
  "targets": [
   "html"
  ]
 },
 {
  "id": "landmark-unique",
  "impact": "moderate",
  "help": "Landmarks should have a unique role or role/label/title (i.e. accessible name) combination",
  "n": 1,
  "targets": [
   ".menu-wrapper"
  ]
 },
 {
  "id": "link-name",
